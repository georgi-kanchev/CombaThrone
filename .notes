upgrades:
- building:
    - none     (default)
    - barrack  (health, unlocks gates)
    - fort     (+health, unlocks +1 garrison)
    - fortress (++health, unlocks tall gate, unlocks both +2 garrisons, requires iron gate)
- entry:
    - hole       (default)
    - door       (defence)
    - short gate (+defence, unlocks tall characters, unlocks fort)
    - tall gate  (++defence, unlocks giant characters)
- garrisons:
    - none  (default)
    - one   (+1 garrison, requires fort)
    - two   (+2 garrisons, requires fortress)
    - three (+2 garrisons, requires fortress)

characters:
- village:
    - girl      bring more gold, slower
    - boy       bring less gold, faster
    - woman     heal unit in front
    - man       cheap but weak brawler
    - grandma   healing buff radius
    - grandpa   damage buff radius
    - hunter    ???
    - fisherman ??? hook someone up a lane